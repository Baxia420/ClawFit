{
  // Model fields are intentionally absent. Run pnpm models:smoke, then pnpm models:configure.
  plugins: {
    allow: ["google", "whatsapp", "clawfit-health"],
    entries: {
      "clawfit-health": {
        enabled: true,
        config: { apiUrl: "http://127.0.0.1:4000" },
      },
    },
  },
  tools: {
    profile: "minimal",
    alsoAllow: [
      "estimate_nutrition",
      "create_pending_meal",
      "get_pending_meal",
      "confirm_pending_meal",
      "log_meal",
      "update_meal",
      "delete_meal",
      "get_meal",
      "get_recent_meals",
      "get_daily_nutrition",
      "save_food_preset",
      "find_food_preset",
      "update_food_preset",
      "delete_food_preset",
      "start_workout",
      "get_active_workout",
      "add_workout_set",
      "update_workout_set",
      "delete_workout_set",
      "finish_workout",
      "get_previous_exercise_performance",
      "get_workout_history",
    ],
    deny: ["group:runtime", "group:fs", "browser", "web_fetch"],
  },
  channels: {
    whatsapp: {
      dmPolicy: "pairing",
      groupPolicy: "disabled",
    },
  },
}
