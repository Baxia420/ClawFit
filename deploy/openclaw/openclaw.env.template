# ClawFit OpenClaw Gateway Production Environment
# Target Location: /home/clawfit/.openclaw/.env
# File Permissions: chmod 600 /home/clawfit/.openclaw/.env
# Ownership: chown clawfit:clawfit /home/clawfit/.openclaw/.env
#
# NEVER commit real secret values to version control.

# Render Health API Target (Use your deployed onrender.com origin)
HEALTH_API_URL=https://<render-service-name>.onrender.com

# Dedicated OpenClaw Machine Token (Must match HEALTH_API_OPENCLAW_TOKEN on Render; min 24 chars)
HEALTH_API_OPENCLAW_TOKEN=replace-with-a-long-random-openclaw-token-min-24-chars

# Authorized WhatsApp Sender E.164 Phone Numbers (Primary and Partner)
CLAWFIT_WHATSAPP_ALLOW_FROM=+60123456789,+60198765432

# Authorized WhatsApp Shared Group JID(s) (Obtained from WhatsApp Web / OpenClaw runtime)
CLAWFIT_WHATSAPP_ALLOWED_GROUP_IDS=123456789-987654@g.us

# Google Gemini API Key (Required for multimodal estimation and model turns)
GEMINI_API_KEY=replace-with-google-gemini-api-key

# Production Application Timezone
APP_TIMEZONE=Asia/Kuala_Lumpur
