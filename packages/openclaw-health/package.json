{
  "name": "@clawfit/openclaw-health",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "files": [
    "dist",
    "skills",
    "openclaw.plugin.json"
  ],
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "validate": "pnpm build && openclaw plugins validate --root . --entry dist/index.js"
  },
  "dependencies": {
    "typebox": "1.3.3"
  },
  "peerDependencies": {
    "openclaw": ">=2026.7.1-2"
  },
  "devDependencies": {
    "openclaw": "2026.7.1-2"
  },
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "compat": {
      "pluginApi": ">=2026.7.1-2",
      "minGatewayVersion": "2026.7.1-2"
    },
    "build": {
      "openclawVersion": "2026.7.1-2",
      "pluginSdkVersion": "2026.7.1-2"
    }
  }
}
