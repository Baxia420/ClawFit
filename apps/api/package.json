{
  "name": "@clawfit/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "tsx --conditions=development watch src/server.ts",
    "build:dependencies": "pnpm --filter @clawfit/health-core build && pnpm --filter @clawfit/db build",
    "clean": "node --input-type=module --eval \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true })\"",
    "build": "pnpm run build:dependencies && pnpm run clean && tsc -p tsconfig.json",
    "smoke:runtime": "pnpm run build && node scripts/runtime-smoke.mjs",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@clawfit/db": "workspace:*",
    "@clawfit/health-core": "workspace:*",
    "dotenv": "latest",
    "fastify": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "^7.0.2"
  }
}
