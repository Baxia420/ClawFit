GEMINI_API_KEY=
# Optional backup keys from distinct, operator-verified Google projects.
# Configure independently on CIA and the Health API. Never add to browser env.
# GEMINI_API_KEY_1=
# GEMINI_API_KEY_2=
# GEMINI_API_KEY_3=
# GEMINI_API_KEY_4=
# Additional slots through GEMINI_API_KEY_8 are supported.
DATABASE_URL=postgresql://clawfit:clawfit@localhost:5432/clawfit
# Dedicated machine tokens (must be distinct and at least 24 characters)
HEALTH_API_WEB_TOKEN=replace-with-a-long-random-web-token-min-24-chars
HEALTH_API_OPENCLAW_TOKEN=replace-with-a-long-random-openclaw-token-min-24-chars
CLAWFIT_WHATSAPP_ALLOWED_GROUP_IDS=123456789-987654@g.us
HEALTH_API_URL=http://127.0.0.1:4000
HOST=127.0.0.1
PORT=4000
APP_TIMEZONE=Asia/Kuala_Lumpur
CALORIE_TARGET=2200
PROTEIN_TARGET=160
NUTRITION_MODEL_PRIMARY=
NUTRITION_MODEL_FALLBACK=
CLAWFIT_WHATSAPP_ALLOW_FROM=+60123456789
